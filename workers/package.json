{
  "name": "ntfy-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute ntfy --local --file=src/database/schema.sql",
    "db:migrate:remote": "wrangler d1 execute ntfy --remote --file=src/database/schema.sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.3.0",
    "wrangler": "^4.54.0"
  }
}
